# Flash Storefront — OAuth & Authentication Environment Variables

# ==============================================================================
# BROWSER / PUBLIC CONFIGURATION (Exposed to Vite Frontend)
# ==============================================================================

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript origins: http://localhost:3000 (and your production domain)
# Authorized redirect URIs: http://localhost:3000/login (and your production domain)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Razorpay Test Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_TSHa6T1dhpiA9w

# Sign in with Apple Services ID
# Obtain from Apple Developer Portal -> Certificates, Identifiers & Profiles -> Identifiers -> Services IDs
VITE_APPLE_CLIENT_ID=com.flash.storefront.client

# Sign in with Apple Redirect URI
# Must match a Return URL configured in your Apple Services ID configuration
# Note: For web Sign in with Apple, Apple requires a public HTTPS domain in production
VITE_APPLE_REDIRECT_URI=http://localhost:3000/login

# ==============================================================================
# SERVER-ONLY SECRETS (Never expose to browser frontend)
# ==============================================================================

# Apple Developer Team ID & Key details for server-side token validation
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
